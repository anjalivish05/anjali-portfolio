# ==========================================
# Anjali Portfolio Environment Configuration
# ==========================================

# Server Environment: development | production
ENVIRONMENT=production

# PostgreSQL Database Connection String
# Example (Local PostgreSQL): postgresql://postgres:your_password@localhost:5432/portfolio_db
# Example (Supabase / Neon / Railway): postgresql://postgres:password@ep-sample.region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_db

# Resend API Key for Transactional Emails
# Obtain your free API key at: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# Notification Recipient Email (Where visitor messages arrive)
NOTIFICATION_EMAIL=anjali13anuj@gmail.com

# Sender Email (Verified domain or Resend default sandbox sender)
SENDER_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Allowed CORS Origins (Comma-separated for multiple production/staging domains)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://anjali-portfolio.vercel.app
